# Local development; copy to .env and customize only if needed.
HOST=127.0.0.1
PORT=8787

# For an Internet deployment, configure your own HTTPS origin and a random
# site access key (16+ characters). Do not include a trailing slash.
# PUBLIC_ORIGIN=https://screen.your-domain.example
# SITE_ACCESS_KEY=replace-with-a-random-secret

# Optional: your own coturn server. TURN_SECRET must be 32+ characters,
# identical to coturn static-auth-secret. It is NEVER sent to the browser.
# STUN_URLS=stun:turn.your-domain.example:3478
# TURN_URLS=turn:turn.your-domain.example:3478?transport=udp,turn:turn.your-domain.example:3478?transport=tcp
# TURN_SECRET=replace-with-a-long-random-secret
# ICE_RELAY_ONLY=false

# Optional direct HTTPS instead of a reverse proxy:
# TLS_CERT=/absolute/path/fullchain.pem
# TLS_KEY=/absolute/path/privkey.pem

# Account database directory (single server instance; back up this folder)
ACCOUNT_DATA_DIR=./data
